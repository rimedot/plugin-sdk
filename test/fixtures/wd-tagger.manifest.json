{
  "formatVersion": 1,
  "source": "https://github.com/rimedot/wd-tagger",
  "kind": "processor",
  "id": "github.com/rimedot/wd-tagger",
  "name": "WD Tagger",
  "version": "0.3.0",
  "requiresMeva": ">=0.2.0",
  "description": "Tags images and videos with the WD tagger models (Danbooru-style tags) and rates them for safety.",
  "publisher": {
    "name": "Meva"
  },
  "settings": [
    {
      "id": "endpoint",
      "label": "Tagger",
      "type": "endpoint",
      "default": "device",
      "description": "Where the model runs: this device (Meva's own runtime, on the GPU when it can), a paired GPU worker, Meva's AI worker (Settings → AI), or the URL of a tagger service."
    },
    {
      "id": "model",
      "label": "Model",
      "type": "model",
      "default": "wd-eva02-large-tagger-v3",
      "description": "Used on this device and by GPU workers. Download it once below."
    },
    {
      "id": "threshold",
      "label": "Minimum confidence",
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "videoFrames",
      "label": "Video frames",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 24,
      "step": 1,
      "description": "Frames sampled from each video."
    }
  ],
  "processor": {
    "media": [
      "image",
      "video"
    ],
    "protocol": "meva-tagger",
    "endpoint": "{endpoint}",
    "model": "{model}",
    "threshold": "{threshold}",
    "videoFrames": "{videoFrames}",
    "writes": {
      "aiTags": true,
      "classification": true
    },
    "adoptsLegacyTags": true,
    "models": [
      {
        "id": "wd-eva02-large-tagger-v3",
        "label": "WD EVA02 Large v3",
