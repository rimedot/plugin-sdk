{
  "formatVersion": 1,
  "source": "https://github.com/rimedot/joycaption",
  "kind": "processor",
  "id": "github.com/rimedot/joycaption",
  "name": "JoyCaption",
  "version": "0.3.0",
  "requiresMeva": ">=0.4.0",
  "description": "Describes images and videos with JoyCaption Beta One, on this PC (llama.cpp, about 5.8 GB) or a GPU worker: a description, what it sees (people, clothing, setting, text) and tags from the description.",
  "publisher": {
    "name": "Meva"
  },
  "settings": [
    {
      "id": "endpoint",
      "label": "Runs on",
      "type": "endpoint",
      "default": "meva:ai-worker",
      "description": "This PC (its GPU or CPU, through llama.cpp), a paired GPU worker, or an address that serves JoyCaption."
    },
    {
      "id": "model",
      "label": "Model",
      "type": "model",
      "default": "joycaption-beta-one"
    },
    {
      "id": "videoFrames",
      "label": "Video frames",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 24,
      "step": 1,
      "description": "Frames sampled from each video; the middle one is described."
    }
  ],
  "processor": {
    "media": [
      "image",
      "video"
    ],
    "protocol": "meva-tagger",
    "endpoint": "{endpoint}",
    "model": "{model}",
    "videoFrames": "{videoFrames}",
    "writes": {
      "aiTags": true,
      "descriptions": true,
      "attributes": true
    },
    "models": [
      {
        "id": "joycaption-beta-one",
        "label": "JoyCaption Beta One",
